										<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="margin-top-30">

											<div class="form-group">
												<label asp-for="Input.FName">First Name</label>
												<span asp-validation-for="Input.FName" class="text-danger"></span>
												<input asp-for="Input.FName" class="form-control" aria-required="true" placeholder="Enter your first name" required />
											</div>
											<div class="form-group">
												<label asp-for="Input.LName">Last Name</label>
												<span asp-validation-for="Input.LName" class="text-danger"></span>
												<input asp-for="Input.LName" class="form-control" aria-required="true" placeholder="Enter your last name" required />
											</div>
											<div class="form-group">
												<label asp-for="Input.Email">Email</label>
												<span asp-validation-for="Input.Email" class="text-danger"></span>
