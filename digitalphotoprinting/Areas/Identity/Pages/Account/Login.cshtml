											</div>
											<div class="form-group">
												<label asp-for="Input.Address">Address</label>
												<span asp-validation-for="Input.Address" class="text-danger"></span>
												<input asp-for="Input.Address" class="form-control" aria-required="true" placeholder="Enter your Address" required />
											</div>
											<div class="form-group">
												<label asp-for="Input.DOB">Date of Birth</label>
												<span asp-validation-for="Input.DOB" class="text-danger"></span>
												<input type="date" asp-for="Input.DOB" class="form-control" aria-required="true" required />
											</div>
											<div class="form-group">
												<label asp-for="Input.Password">Password</label>
												<span asp-validation-for="Input.Password" class="text-danger"></span>
												<input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Choose password" required />
											</div>
											<div class="form-group">
												<label asp-for="Input.ConfirmPassword">Confirm Password</label>
												<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
												<input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Re-enter your password" required />
											</div>
											<label asp-for="Input.Gender">Gender</label>
											<span asp-validation-for="Input.Gender" class="text-danger"></span>
											<div class="form-group">
												<input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Male" required style="height: auto;width: auto;display: inline;accent-color: #987f28;">
												<label>Male</label>
												<input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Female" required style="height: auto;width: auto;display: inline;accent-color: #987f28;">
