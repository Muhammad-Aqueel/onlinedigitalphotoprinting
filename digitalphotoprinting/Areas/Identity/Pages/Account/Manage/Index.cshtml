@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<!-- End body content -->
<!-- ============================
///// Begin content section /////
============================= -->
<section id="content-section" class="album-single">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Begin content wrap -->
                <div class="content-wrap">
                    <div class="row">

                            <!-- Content column -->
                        <div class="col-lg-12 col-md-12 margin-bottom-30">

                            <div class="tabs-wrap">

                                <div class="register-wrapper margin-top-40">

                                <!-- <h1 class="blog-single-post-title">The Truth About Photography</h1> -->
                                <h3>@ViewData["Title"]</h3>
                                <partial name="_StatusMessage" for="StatusMessage" />
                                @if (!string.IsNullOrEmpty(Model.Input.ProfilePicture))
                                {
                                    <div class="col-md-12">
                                        <img src="/uploads/@Model.Input.ProfilePicture" style="width:250px;height:300px" />
                                    </div>
                                }
                                <div class="margin-top-10">
                                    <form id="profile-form" method="post" enctype="multipart/form-data">
                                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Username" class="form-label"></label>
                                            <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Input.PhoneNumber" class="form-label"></label>
                                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Input.FName" class="form-label"></label>
                                            <span asp-validation-for="Input.FName" class="text-danger"></span>
                                            <input asp-for="Input.FName" class="form-control" placeholder="Please enter your first name" />
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Input.LName" class="form-label"></label>
                                            <span asp-validation-for="Input.LName" class="text-danger"></span>
                                            <input asp-for="Input.LName" class="form-control" placeholder="Please enter your last name" />
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Input.DOB" class="form-label"></label>
                                            <span asp-validation-for="Input.DOB" class="text-danger"></span>
                                            <input type="date" asp-for="Input.DOB" class="form-control" />
                                        </div>
                                        <!-- <div class="form-floating mb-3">
                                            <label>Male</label>
                                            <input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Male" />
                                            <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label>Female</label>
                                            <input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Female" />
                                            <label asp-for="Input.Gender">Gender</label>
                                            <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                        </div> -->
                                        <label asp-for="Input.Gender">Gender</label>
                                        <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                        <div class="form-group">
                                            <input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Male" required style="height: auto;width: auto;display: inline;accent-color: #987f28;">
                                            <label>Male</label>
                                            <input type="radio" asp-for="Input.Gender" class="form-control" aria-required="true" value="Female" required style="height: auto;width: auto;display: inline;accent-color: #987f28;">
                                            <label>Female</label>
                                        </div>
                                        <div class="form-floating mb-3">
                                            <label asp-for="Input.Address" class="form-label"></label>
                                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                                            <input asp-for="Input.Address" class="form-control" placeholder="Please enter your address" />
                                        </div>
                                        @*<div class="m-2">
                                            <label class="form-label" for="ProfilePicture">Profile picture</label>
                                            <input asp-for="Input.ImageFile" />
                                        </div>*@

                                        <div class="row">
                                            <div class="col-lg-12"> 
                                                <label class="form-label" for="ProfilePicture">Profile picture</label>
                                                <input asp-for="Input.ImageFile"
                                                        type="file" class="d-none"
                                                        accept=".jpg,.jpeg" style="display: none;" />
                                                <div class="input-group">
                                                    <button class="btn btn-primary"
                                                            type="button"
                                                            onclick="selectFileClick();">
                                                        Select a Image
                                                    </button>
                                                        <input id="ImageFile" type="text"
                                                            class="form-control" readonly="readonly"
                                                            onclick="selectFileClick();" placeholder="Choose Image" />
                                                </div>
                                            </div>
                                        </div>

                                        <button id="update-profile-button" type="submit" class="btn btn-primary btn-rounded-5x btn-block margin-top-30">Save</button>
                                    </form>
                                </div>
                            </div>

                            </div>
                        </div> <!-- /.col (Content column) -->

                    </div> <!-- /.row -->
                </div>
                <!-- End content wrap -->
            </div> <!-- /.col -->
        </div> <!-- /.row -->
        <!-- Begin album bottom nav -->
        <!-- End album bottom nav -->
        <!-- /.row -->
    </div> <!-- /.container -->
</section>
<!-- End content section -->

@section Scripts {
    <script>
        $(document).on('change', ':file', function (e) {
            var file_path = e.target.value;
            var file_name = file_path.split("\\");
            $("#ImageFile").val(file_name[file_name.length - 1]);
        });

        function selectFileClick() {
            $("#Input_ImageFile").trigger("click");
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
