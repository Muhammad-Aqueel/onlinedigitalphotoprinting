@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<!-- End body content -->
<!-- ============================
///// Begin content section /////
============================= -->
<section id="content-section" class="album-single">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Begin content wrap -->
                <div class="content-wrap">
                    <div class="row">

                        <!-- Content column -->
                        <div class="col-lg-12 col-md-12 margin-bottom-30">

                            <div class="tabs-wrap">

                                <div class="register-wrapper margin-top-40">
                                    <h3>@ViewData["Title"]</h3>

                                    <div class="alert alert-warning" role="alert">
                                        <p>
                                            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                                        </p>
                                    </div>

                                    <div>
                                        <form id="delete-user" method="post">
                                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                            @if (Model.RequirePassword)
                                            {
                                                <div class="form-floating mb-3">
                                                    <label asp-for="Input.Password" class="form-label"></label>
                                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                                                </div>
                                            }
                                            <button class="btn btn-danger btn-rounded-5x btn-block margin-top-30" type="submit">Delete data and close my account</button>
                                        </form>
                                    </div>

                                </div>

                            </div>
                        </div> <!-- /.col (Content column) -->

                    </div> <!-- /.row -->
                </div>
                <!-- End content wrap -->
            </div> <!-- /.col -->
        </div> <!-- /.row -->
        <!-- Begin album bottom nav -->
        <!-- End album bottom nav -->
        <!-- /.row -->
    </div> <!-- /.container -->
</section>
<!-- End content section -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
