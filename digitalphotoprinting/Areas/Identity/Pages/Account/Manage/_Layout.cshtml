@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<!-- ==============================
/////// Begin body content ///////
=============================== -->
<div id="body-content">

    <!-- ================================
    ///// Begin page header section /////
    ================================= -->
    <section id="page-header-secion" class="alter-heading">

        <!-- Begin page header image
        ===============================
        * Use class "parallax" to enable parallax effect.
        -->
        <div class="page-header-image parallax bg-image" style="background-image: url(../../../assets/img/headings/heading-11.jpg); background-position: 50% 50%;"></div>
        <!-- End page header image -->
        <!-- Element cover -->
        <div class="cover page-header-cover"></div>

        <!-- Begin page header info -->
        <div class="container-fluid page-header-content no-padding text-center">
            <div class="row">
                <div class="col-md-12">
                    <h1 class ="album-title">Manage your account</h1>
                    <h2>Change your account settings</h2>
                </div> <!-- /.col -->
            </div> <!-- /.row -->
        </div>
        <!-- End page header info -->

    </section>
    <partial name="_ManageNav" />
    <!-- End page header section -->
        @RenderBody()
    <!-- Begin footer -->
