@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<!-- End body content -->
<!-- ============================
///// Begin content section /////
============================= -->
<section id="content-section" class="album-single">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Begin content wrap -->
                <div class="content-wrap">
                    <div class="row">

                        <!-- Content column -->
                        <div class="col-lg-12 col-md-12 margin-bottom-30">

                            <div class="tabs-wrap">

                                <div class="register-wrapper margin-top-40">
                                    <h3>@ViewData["Title"]</h3>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
                                            <p>
                                                <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                                            </p>
                                            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                                                <button class="btn btn-primary btn-rounded-5x btn-block margin-top-30" type="submit">Download</button>
                                            </form>
                                            <p>
                                                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger btn-rounded-5x btn-block margin-top-30">Delete</a>
                                            </p>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div> <!-- /.col (Content column) -->

                    </div> <!-- /.row -->
                </div>
                <!-- End content wrap -->
            </div> <!-- /.col -->
        </div> <!-- /.row -->
        <!-- Begin album bottom nav -->
        <!-- End album bottom nav -->
        <!-- /.row -->
    </div> <!-- /.container -->
</section>
<!-- End content section -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
