@section Scripts {
    <script>
        $(document).on('change', ':file', function (e) {
            var file_path = e.target.value;
            var file_name = file_path.split("\\");
            $("#Image_Name").val(file_name[file_name.length - 1]);
        });

        function selectFileClick() {
            $("#File").trigger("click");
        }

		// Function to toggle the dropdown content
		function toggleDropdown() {
			var dropdownContent = document.getElementById("dropdownContent");
			dropdownContent.style.display = (dropdownContent.style.display === "block") ? "none" : "block";
		}

		// Function to select an option and set the button value
		function selectOption(option) {
			var dropdownButton = document.getElementById("Print_size");
			dropdownButton.value = option.innerHTML;

			// Hide the dropdown content after selecting an option
			var dropdownContent = document.getElementById("dropdownContent");
			dropdownContent.style.display = "none";
		}

		// Close the dropdown if the user clicks outside of it
		window.onclick = function (event) {
			if (!event.target.matches('.dropbtn')) {
				var dropdownContent = document.getElementById("dropdownContent");
				if (dropdownContent.style.display === "block") {
					dropdownContent.style.display = "none";
				}
			}
		}

    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
